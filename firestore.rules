rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile().data.role == "admin";
    }

    function isApprovedPlayer() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (userProfile().data.approved == true || userProfile().data.role == "admin");
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function beforePredictionDeadline(competitionId, matchId) {
      let matchData = get(/databases/$(database)/documents/competitions/$(competitionId)/matches/$(matchId));
      let roundData = get(/databases/$(database)/documents/competitions/$(competitionId)/rounds/$(matchData.data.roundId));
      return roundData.data.status == "published"
        && request.time < roundData.data.deadline;
    }

    // O roundId gravado no palpite tem que ser o da partida: e por ele que a
    // leitura libera os palpites de uma rodada fechada.
    function roundIdMatchesMatch(competitionId, matchId, roundId) {
      return roundId == get(/databases/$(database)/documents/competitions/$(competitionId)/matches/$(matchId)).data.roundId;
    }

    // Prazo da rodada vencido: dai em diante os palpites dela podem ser vistos
    // por todos (aba "Palpites dos jogadores"). Antes disso, ninguem ve o dos outros.
    function roundClosed(competitionId, roundId) {
      return roundId is string
        && request.time >= get(/databases/$(database)/documents/competitions/$(competitionId)/rounds/$(roundId)).data.deadline;
    }

    function beforeKnockoutPredictionDeadline(competitionId, tieId, leg) {
      let tieData = get(/databases/$(database)/documents/competitions/$(competitionId)/knockout/$(tieId));
      return leg == "home"
        ? request.time < tieData.data.homeLegDeadline
        : request.time < tieData.data.awayLegDeadline;
    }

    // A previsao da competicao tem prazo proprio, independente das rodadas.
    // Sem prazo definido pelo admin, ninguem envia.
    function beforeCompetitionPredictionDeadline(competitionId) {
      let settings = /databases/$(database)/documents/competitions/$(competitionId)/settings/competitionPredictions;
      return exists(settings)
        && get(settings).data.deadline != null
        && request.time < get(settings).data.deadline;
    }

    // Liberacao real de quem esta logado (admin conta como liberado). Usado para
    // o perfil publico nao poder dizer algo diferente do perfil privado.
    function ownApproval() {
      let data = userProfile().data;
      return data.approved == true || data.role == "admin";
    }

    // Perfil completo: tem e-mail, papel e preferencias de notificacao. So o
    // dono e o admin leem; os outros jogadores usam profiles/{uid}.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.role == "user"
        && request.resource.data.approved == false;

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.approved == resource.data.approved
        );

      allow delete: if isAdmin() || isOwner(userId);
    }

    // Perfil publico: so nome, foto e se e jogador liberado — o que o ranking e
    // a aba "Palpites dos jogadores" precisam. Qualquer logado le.
    match /profiles/{userId} {
      allow read: if signedIn();

      // O dono escreve o proprio, mas so esses tres campos, e "liberado" tem que
      // bater com o users/{uid} dele: ninguem se libera pelo perfil publico.
      allow create, update: if isAdmin()
        || (
          isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && request.resource.data.keys().hasOnly(['approved', 'name', 'photoURL'])
          && request.resource.data.approved == ownApproval()
        );

      allow delete: if isAdmin() || isOwner(userId);
    }

    match /competitions/{competitionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /teams/{teamId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      match /playerStats/{playerStatId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      match /rounds/{roundId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      // Configuracoes da competicao (ex: prazo das previsoes).
      match /settings/{settingId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      match /matches/{matchId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      match /predictions/{predictionId} {
        // Os proprios sempre; os dos outros so com a rodada fechada; o admin tudo.
        // Consultas precisam filtrar por userId (os meus) ou roundId (rodada
        // fechada) para o servidor conseguir provar a regra.
        allow read: if signedIn() && (
          isAdmin()
          || resource.data.userId == request.auth.uid
          || roundClosed(competitionId, resource.data.roundId)
        );

        allow create: if isApprovedPlayer()
          && request.resource.data.userId == request.auth.uid
          && roundIdMatchesMatch(competitionId, request.resource.data.matchId, request.resource.data.roundId)
          && beforePredictionDeadline(competitionId, request.resource.data.matchId);

        allow update: if isApprovedPlayer()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.matchId == resource.data.matchId
          && roundIdMatchesMatch(competitionId, resource.data.matchId, request.resource.data.roundId)
          && beforePredictionDeadline(competitionId, resource.data.matchId);

        allow delete: if isAdmin() || resource.data.userId == request.auth.uid;
      }

      match /knockoutPredictions/{predictionId} {
        // Ninguem ve o palpite do mata-mata dos outros pelo app; so o dono e o admin.
        allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);

        allow create: if isApprovedPlayer()
          && request.resource.data.userId == request.auth.uid
          && beforeKnockoutPredictionDeadline(
            competitionId,
            request.resource.data.tieId,
            request.resource.data.leg
          );

        allow update: if isApprovedPlayer()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.tieId == resource.data.tieId
          && request.resource.data.leg == resource.data.leg
          && beforeKnockoutPredictionDeadline(
            competitionId,
            resource.data.tieId,
            resource.data.leg
          );

        allow delete: if isAdmin() || resource.data.userId == request.auth.uid;
      }

      match /competitionPredictions/{predictionId} {
        // Previsoes da competicao: so o dono e o admin.
        allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);

        allow create: if isApprovedPlayer()
          && predictionId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && beforeCompetitionPredictionDeadline(competitionId);

        // Jogador nao reedita o que enviou. So o admin corrige, para padronizar a
        // grafia dos nomes sem trocar o dono da previsao.
        allow update: if isAdmin()
          && request.resource.data.userId == resource.data.userId;

        allow delete: if isAdmin() || resource.data.userId == request.auth.uid;
      }

      match /competitionPredictionResults/{resultId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      match /scores/{scoreId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      match /knockout/{tieId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      // Ranking calculado no servidor (api/recalculate-ranking) com o Admin SDK,
      // que ignora estas regras. Ninguem grava pelo navegador, nem o admin.
      match /ranking/{docId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }
  }
}
